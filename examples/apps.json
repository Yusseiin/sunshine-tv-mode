{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png"
    },
    {
      "name": "Steam Big Picture",
      "detached": [
        "open steam://open/bigpicture"
      ],
      "prep-cmd": [
        {
          "do": "",
          "undo": "open steam://close/bigpicture"
        }
      ],
      "image-path": "steam.png"
    },
    {
      "name": "Donkey Kong Bananza",
      "cmd": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh start org.nxnative.040074a01bf12000",
      "prep-cmd": [
        {
          "do": "",
          "undo": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh stop org.nxnative.040074a01bf12000"
        }
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/donkey-kong-bananza.png"
    },
    {
      "name": "Pokémon Pokopia",
      "cmd": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh start org.nxnative.0400a3a01ee4c000",
      "prep-cmd": [
        {
          "do": "",
          "undo": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh stop org.nxnative.0400a3a01ee4c000"
        }
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/pokemon-pokopia.png"
    },
    {
      "name": "Donkey Kong Bananza (HUD)",
      "cmd": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh start org.nxnative.040074a01bf12000 DM_METAL_HUD=1",
      "prep-cmd": [
        {
          "do": "",
          "undo": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh stop org.nxnative.040074a01bf12000"
        }
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/donkey-kong-bananza-hud.png"
    },
    {
      "name": "Pokémon Pokopia (HUD)",
      "cmd": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh start org.nxnative.0400a3a01ee4c000 DM_METAL_HUD=1",
      "prep-cmd": [
        {
          "do": "",
          "undo": "/Users/YOUR_USER/.config/sunshine/scripts/nxgame.sh stop org.nxnative.0400a3a01ee4c000"
        }
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/pokemon-pokopia-hud.png"
    },
    {
      "name": "TV Mode 4K",
      "detached": [
        "/Users/YOUR_USER/.config/sunshine/scripts/tvswitch.sh 4k"
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/tv-mode-4k.png"
    },
    {
      "name": "TV Mode 1080p",
      "detached": [
        "/Users/YOUR_USER/.config/sunshine/scripts/tvswitch.sh 1080p"
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/tv-mode-1080p.png"
    },
    {
      "name": "TV Mode OFF",
      "detached": [
        "/Users/YOUR_USER/.config/sunshine/scripts/tvswitch.sh off"
      ],
      "image-path": "/Users/YOUR_USER/.config/sunshine/covers/tv-mode-off.png"
    }
  ]
}